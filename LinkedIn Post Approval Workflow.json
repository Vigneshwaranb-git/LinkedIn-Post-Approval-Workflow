      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nreturn items.map(item => {\n  const json = { ...item.json };\n\n  // Rename the approval JSON field\n  if (json.data && typeof json.data.approved === 'boolean') {\n    json.approval = json.data;\n    delete json.data;\n  }\n\n  return {\n    ...item,\n    json,\n    binary: item.binary,\n  };\n});"
